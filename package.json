{
  "name": "commons",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:server": "NODE_ENV=development PORT=3001 HOST=127.0.0.1 node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js scripts/*.test.mjs",
    "admin": "node server/admin.js",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "format:check": "prettier --check src server scripts index.html vite.config.js package.json",
    "format": "prettier --write src server scripts index.html vite.config.js package.json"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "prettier": "^3.9.10",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
