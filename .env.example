# Production origin only: no path, query, or trailing slash.
PUBLIC_URL=https://community.example.org
# Public operator/publisher identity and monitored account/privacy contact.
# Replace these placeholders before launch.
OPERATOR_NAME=Your organization or name
CONTACT_EMAIL=contact@example.org
APP_PORT=3000
IMAGE_TAG=local
# Use 1 only behind exactly one trusted reverse proxy, forwarding HTTPS.
TRUST_PROXY=1
# Create this directory with owner UID/GID 1000 and mode 0700 before starting.
BACKUP_DIR=./backups
# Direct Node execution only (Compose sets its own container path):
DATABASE_PATH=./data/commons.sqlite
